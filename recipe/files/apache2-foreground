#!/bin/sh
# Apache in the foreground as the container's main process, started the way the official php:apache
# image's apache2-foreground starts it: the Apache environment from envvars (APACHE_RUN_USER and the
# others can be overridden from the container environment), no stale pid file, the run/lock/log dirs
# present.
set -e
: "${APACHE_CONFDIR:=/etc/apache2}"
: "${APACHE_ENVVARS:=$APACHE_CONFDIR/envvars}"
if [ -f "$APACHE_ENVVARS" ]; then
  . "$APACHE_ENVVARS"
fi
: "${APACHE_RUN_DIR:=/var/run/apache2}"
: "${APACHE_PID_FILE:=$APACHE_RUN_DIR/apache2.pid}"
rm -f "$APACHE_PID_FILE"
for d in "$APACHE_RUN_DIR" "${APACHE_LOCK_DIR:-}" "${APACHE_LOG_DIR:-}"; do
  [ -z "$d" ] || mkdir -p "$d"
done
exec apache2 -DFOREGROUND "$@"
